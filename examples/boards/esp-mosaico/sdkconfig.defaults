CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../boards/esp-mosaico/partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_CONFIRM_BY_APP=y

# Iris USB is on so Recovery-first install can see the application become healthy.
# Turn this off only when the console must stay on UART0.
CONFIG_ESP_MOSAICO_EXAMPLE_IRIS=y
# When Iris is enabled, Recovery/OTA/health/system-inventory comes from upstream
# esp_mosaico_app_recovery component. Health is accepted explicitly after the
# first presented Game frame; this integration does not enable its optional
# auto-accept Kconfig path. Retained Recovery performs USB installation into ota_0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v1"
CONFIG_ESP_IRIS_BOARD_ID="esp-mosaico"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-recovery-2m-v1"
CONFIG_ESP_IRIS_RECOVERY_ABI=1
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
CONFIG_ESP_IRIS_TRANSPORT_USB=y
# CONFIG_ESP_IRIS_TRANSPORT_USB_SERIAL_JTAG is not set
# CONFIG_ESP_IRIS_TRANSPORT_TCP is not set
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_TINYUSB_CDC_RX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_EP_BUFSIZE=2048
CONFIG_ESP_IRIS_USB_PRODUCT="Raylib Lite ESP-Mosaico"
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_OTA_DEFAULT_VIA_RECOVERY=y
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y

CONFIG_BSP_CO5300_ENABLE_TE=y
