menu "Raylib Lite Engine"

config MOSAICO_GAME_DEFAULT_FPS
    int "Default target frame rate"
    range 1 120
    default 30

config MOSAICO_GAME_EVENT_QUEUE_LENGTH
    int "Legacy device event queue length"
    range 8 128
    default 32

config MOSAICO_GAME_MAX_TEXTURES
    int "Maximum simultaneously loaded atlases"
    range 1 32
    default 12

config MOSAICO_GAME_RASTER_PROFILE
    bool "Time triangle setup and raster stages"
    default n

config MOSAICO_GAME_RASTER_BENCHMARK
    bool "Run startup raster microbenchmarks"
    default n

endmenu
